generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id @default(uuid())
  clientName   String
  projectTitle String
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  price        Float
  status       String   @default("On Progress")
  deadline     DateTime
  notes        String   @default("") @db.Text
  previewImage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}

model Category {
  id       String    @id
  name     String    @unique
  iconName String    @default("Tag")
  projects Project[]

  @@map("categories")
}
