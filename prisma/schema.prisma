generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id @default(uuid())
  clientName   String
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectTitle String
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  price        Float
  status       String   @default("On Progress")
  deadline     DateTime
  notes        String   @default("") @db.Text
  referenceLink String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}

model Category {
  id       String    @id
  name         String    @unique
  iconName     String    @default("Tag")
  defaultPrice Float     @default(0)
  projects     Project[]

  @@map("categories")
}

model Client {
  id          String    @id @default(uuid())
  name        String
  phone       String    @default("")
  email       String    @default("")
  address     String    @default("") @db.Text
  company     String    @default("")
  notes       String    @default("") @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@map("clients")
}

model Studio {
  id        String   @id @default("default")
  name      String   @default("Design Studio")
  tagline   String   @default("Creative Design Solutions")
  address   String   @default("Jakarta, Indonesia")
  contact   String   @default("studio@example.com | +62 812-3456-7890")
  bankInfo  String   @default("BCA 872-0492-911 a.n. Design Studio")
  logo      String   @default("") @db.Text
  updatedAt DateTime @updatedAt

  @@map("studio")
}
